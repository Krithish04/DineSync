# ==========================================
# DineSync AI Production Environment Configuration
# ==========================================

PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://dinesync_admin:<password>@cluster0.dinesync.mongodb.net/dinesync_prod?retryWrites=true&w=majority
JWT_SECRET=production-super-secret-jwt-key-replace-this-in-prod-dinesync-2026
JWT_EXPIRES_IN=7d

CLIENT_URL=https://app.dinesync.ai
AI_SERVICE_URL=https://ai.dinesync.ai/api/v1

# SMTP Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.YourSendGridApiKeyHere
EMAIL_FROM=noreply@dinesync.ai

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
